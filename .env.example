# ============================================================
# NutriMatch Laravel 11 Backend — Environment Configuration
# COPY THIS FILE TO .env AND FILL IN YOUR VALUES
# NEVER COMMIT .env TO VERSION CONTROL
# ============================================================

APP_NAME="NutriMatch"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000
APP_TIMEZONE=Asia/Manila

# ============================================================
# LOGGING
# ============================================================
LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# ============================================================
# DATABASE
# ============================================================
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=nutrimatchdb
DB_USERNAME=root
DB_PASSWORD=

# ============================================================
# SESSION & CACHE
# ============================================================
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

# ============================================================
# MAIL (use Mailtrap for development)
# ============================================================
MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="noreply@nutrimatch.ph"
MAIL_FROM_NAME="${APP_NAME}"

# ============================================================
# SANCTUM (API Authentication)
# ============================================================
SANCTUM_STATEFUL_DOMAINS=localhost:3000,localhost:3001,127.0.0.1:3000

# ============================================================
# USDA FoodData Central API
# Get your free key at: https://fdc.nal.usda.gov/api-key-signup.html
# ============================================================
USDA_API_KEY=
USDA_API_BASE_URL=https://api.nal.usda.gov/fdc/v1
USDA_CACHE_TTL_HOURS=24

# ============================================================
# PAYMONGO (Philippine Payment Gateway)
# Get keys at: https://dashboard.paymongo.com
# ============================================================
PAYMONGO_SECRET_KEY=
PAYMONGO_PUBLIC_KEY=
PAYMONGO_WEBHOOK_SECRET=
PAYMONGO_BASE_URL=https://api.paymongo.com/v1

# ============================================================
# DAILY.CO (Video Consultation)
# Get your API key at: https://dashboard.daily.co/developers
# ============================================================
DAILY_CO_API_KEY=
DAILY_CO_DOMAIN=
DAILY_CO_BASE_URL=https://api.daily.co/v1

# ============================================================
# CORS (set to your Nuxt frontend URL)
# ============================================================
FRONTEND_URL=http://localhost:3000
